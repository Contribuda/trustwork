<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Discovery and outreach prototype</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#111827;--muted:#5b6472;--line:#dde1e7;--brand:#1f5fd6;--brand-ink:#fff;--ok:#0f7a3d;--okbg:#e6f4ec;--warn:#8a5a00;--warnbg:#fff4dc;--bad:#a1271b;--badbg:#fde8e6;--info:#1f4f99;--infobg:#e8f0fd;--band:#0f172a}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d1117;--card:#161b22;--ink:#e6edf3;--muted:#9aa4b2;--line:#2d333b;--brand:#5b9bff;--brand-ink:#0d1117;--ok:#56d38a;--okbg:#10291b;--warn:#f0c060;--warnbg:#2c2410;--bad:#ff8a7a;--badbg:#341613;--info:#8ab4ff;--infobg:#132238;--band:#000}}
*{box-sizing:border-box}
body{margin:0;font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
a{color:var(--brand)}
.demo{background:var(--warnbg);color:var(--warn);padding:6px 16px;font-size:13px;border-bottom:1px solid var(--line)}
header{background:var(--band);color:#fff;padding:10px 16px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;font-weight:700}
.sq{display:inline-grid;grid-template-columns:repeat(3,8px);gap:2px}.sq i{width:8px;height:8px;background:#3b82f6;display:block}
.band small{opacity:.8;font-weight:400}
.lang button{background:transparent;color:#fff;border:1px solid #475569;padding:4px 10px;border-radius:6px;cursor:pointer;font:inherit;font-size:13px}
.lang button[aria-pressed="true"]{background:#fff;color:#0f172a}
nav.tabs{display:flex;gap:4px;overflow-x:auto;padding:8px 16px;background:var(--card);border-bottom:1px solid var(--line)}
nav.tabs button{white-space:nowrap;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:8px 12px;border-radius:8px;cursor:pointer;font:inherit;font-size:14px}
nav.tabs button[aria-selected="true"]{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
main{max-width:1180px;margin:0 auto;padding:16px}
h1{font-size:22px;margin:4px 0 4px}h2{font-size:17px;margin:18px 0 8px}h3{font-size:15px;margin:12px 0 6px}
.lede{color:var(--muted);margin:0 0 12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:12px}
.grid{display:grid;gap:12px}.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:2fr 1fr}
@media (max-width:820px){.g2,.g3{grid-template-columns:1fr}}
.badge{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid transparent}
.b-src{background:var(--infobg);color:var(--info)}.b-ok{background:var(--okbg);color:var(--ok)}.b-warn{background:var(--warnbg);color:var(--warn)}.b-bad{background:var(--badbg);color:var(--bad)}.b-mut{background:transparent;color:var(--muted);border-color:var(--line)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600;font-size:13px}
@media (max-width:640px){table.resp thead{display:none}table.resp tr{display:block;border:1px solid var(--line);border-radius:8px;margin-bottom:8px;padding:6px}table.resp td{display:block;border:0;padding:3px 4px}table.resp td::before{content:attr(data-l);display:block;color:var(--muted);font-size:12px}}
.btn{border:1px solid var(--line);background:var(--card);color:var(--ink);padding:8px 12px;border-radius:8px;cursor:pointer;font:inherit;font-size:14px;margin:4px 6px 4px 0}
.btn.primary{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn:focus-visible,nav.tabs button:focus-visible,.lang button:focus-visible{outline:3px solid #f59e0b;outline-offset:2px}
.muted{color:var(--muted)}.small{font-size:13px}
.src{font-size:12px;color:var(--muted)}
.gate{display:flex;gap:10px;align-items:flex-start;padding:7px 0;border-bottom:1px dashed var(--line)}
.gate .ic{flex:0 0 74px}
.msg{white-space:pre-wrap;font-family:ui-serif,Georgia,serif;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:14px;font-size:14px}
.lock{background:var(--infobg);border-left:3px solid var(--info);padding:0 4px}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--band);color:#fff;padding:10px 16px;border-radius:8px;font-size:14px;display:none;max-width:90vw;z-index:9}
.list button.item{display:block;width:100%;text-align:left;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:10px;margin-bottom:8px;cursor:pointer;font:inherit}
.list button.item[aria-current="true"]{border-color:var(--brand);box-shadow:0 0 0 2px var(--brand) inset}
.steps{list-style:none;padding:0;margin:0}.steps li{display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-bottom:1px solid var(--line)}
select,input[type=text],textarea{font:inherit;padding:7px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink);max-width:100%}
label{display:block;margin:8px 0 4px;font-weight:600;font-size:14px}
.flow{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}.flow span{padding:4px 8px;border-radius:6px;border:1px solid var(--line);font-size:13px}.flow span.on{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:14px}
.notice{padding:10px;border-radius:8px;margin:8px 0;font-size:14px}
</style>
</head>
<body>
