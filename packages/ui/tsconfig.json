{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tokens/**/*.ts",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "tests/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
