# Local-only development values. No production credentials.
# Nothing loads this file implicitly: export the variables you need, or pass them on the command line
# (see docs/engine/agent-onboarding.md, "Install and run"). Every variable below is read by the code today
# (apps/api/src/config.ts, apps/api/src/app.ts, packages/data/src/config.ts, apps/web).

# --- Database (migrator / dev seed) ---------------------------------------------------------------
DATABASE_URL=postgresql://trustwork_dev:local_only_change_me@localhost:54329/trustwork_dev
# Split form instead of DATABASE_URL: TRUSTWORK_DATABASE_HOST, _PORT, _NAME, _USER, _PASSWORD

# --- API process (apps/api) -----------------------------------------------------------------------
# Runtime connection with the restricted role printed by `npm run seed:dev -w @trustwork/api`.
# Falls back to DATABASE_URL; the API refuses a superuser or BYPASSRLS role.
# Without any URL only /health, /health/live and /health/ready (not ready) are served.
# API_DATABASE_URL=postgresql://trustwork_api_login:local_only_api_password@localhost:54329/trustwork_dev
API_HOST=127.0.0.1
API_PORT=3001
# Exact origin the browser loads the app from. Required and https with NODE_ENV=production.
PUBLIC_ORIGIN=http://127.0.0.1:3001
# Hex, at least 32 bytes (`openssl rand -hex 32`). Required with NODE_ENV=production; random per process otherwise.
# AUTH_FLOW_SECRET=
# Plain-http hosts other than localhost only; refused with NODE_ENV=production.
API_INSECURE_COOKIES=false
# disabled | fake (local only, refused in production) | live
AUTH_PROVIDER_MODE=disabled
# Live mode only: OIDC client credentials per provider (never commit real values).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Path the provider callback returns to, relative to PUBLIC_ORIGIN.
AUTH_RETURN_PATH=/
# Terms version recorded at sign-up (default draft-2026-10).
# TERMS_VERSION=draft-2026-10
# NODE_ENV=production

# Runtime pool and per-connection limits (statement_timeout, idle_in_transaction_session_timeout).
API_DB_POOL_MAX=10
API_DB_STATEMENT_TIMEOUT_MS=15000
API_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
API_DB_CONNECT_TIMEOUT_MS=5000

# Client address for rate limits and lockout: by default X-Forwarded-For is ignored (socket peer).
# Behind a reverse proxy set ONE of: the number of proxy hops in front of the API, or the proxies' addresses/CIDRs.
API_TRUSTED_PROXY_HOPS=0
# API_TRUSTED_PROXIES=10.0.0.0/8

# Structured JSON logs on stdout: debug | info | warn | error. Principals appear as keyed pseudonyms.
API_LOG_LEVEL=info
# Optional hex key (>= 32 bytes) for log pseudonyms; derived from AUTH_FLOW_SECRET when unset.
# API_LOG_PSEUDONYM_SECRET=
# 1 prints fake outbound mail (with tokens) to stdout in fake provider mode; local only.
# API_LOG_MAIL=1

# Readiness: probe timeout and (optionally) the migrations directory this build ships.
API_READINESS_TIMEOUT_MS=2000
# API_MIGRATIONS_DIR=

# OpenTelemetry-compatible export (OTLP/HTTP JSON). Unset = no-op: nothing is recorded or sent.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=key=value
OTEL_SERVICE_NAME=trustwork-api
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_TRACES_SAMPLER_ARG=1

# Session, password, token, lockout and idempotency tuning: see apps/api/src/modules/identity/README.md.

# --- Both processes (API and web) -----------------------------------------------------------------
# Strict-Transport-Security, sent exactly as written; unset (default) = no HSTS header. HSTS pins the whole host
# (with includeSubDomains every subdomain) to HTTPS for max-age: set it only when the app owns the whole host, never
# for an app served under a path of another site's domain. includeSubDomains and preload are never added for you.
# TRUSTWORK_HSTS=max-age=31536000

# --- Web process (apps/web) -----------------------------------------------------------------------
# Build-time values (inlined by Next). The base path is compiled into routes and assets; the site URL and
# the brand below are fallbacks for the runtime values TRUSTWORK_SITE_URL and TRUSTWORK_BRAND.
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_BASE_PATH=
# none hides the Russian-only brand overlay (docs/oss/BRAND.md).
# NEXT_PUBLIC_TRUSTWORK_BRAND=
# Runtime values, read when the server starts (docs/country-packs/configuration.md).
# Extra hosts allowed for server actions behind a proxy, comma separated.
# TRUSTWORK_ALLOWED_ORIGINS=
# Deployment configuration file and data directory (country packs, dictionaries, demo-content overrides,
# brand overlays). Invalid or restricted data stops the server at start.
# TRUSTWORK_CONFIG=
# TRUSTWORK_DATA_DIR=
# Default country for visitors who have not chosen one (ISO 3166-1 alpha-2, or none; never a restricted
# place). Unset: the engine has none and visitors choose (ADR 012 decision 11). The reference hub uses US
# (ADR 012, decisions 26 and 31).
# TRUSTWORK_DEFAULT_COUNTRY=US
