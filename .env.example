# Live mode: the API origin for server rendering and the same-origin /v1/* rewrite (read when the build or the dev server
# starts; default http://127.0.0.1:3001 outside production; production behind a reverse proxy routes /v1/* itself).
# TRUSTWORK_API_ORIGIN=http://127.0.0.1:3001

# No external provider is called by this code: mail is a fake mailbox until MAIL-001, and payment, model,
# storage and channel providers are designed ports with fakes, configured per hub once they exist.
